# Browser-facing URLs. These values are not secrets.
TOOL_PUBLIC_BASE_URL=http://localhost:8700
EDITOR_PUBLIC_URL=http://localhost:8601/
EDITOR_ORIGIN=http://localhost:8601
PORT=8700

# Persistent prototype storage.
MONGO_URL=mongodb://127.0.0.1:27018/ft_learning
DATA_DIR=./data

# Copy these values from Moodle's "View configuration details" dialog.
LTI_ISSUER=http://localhost:8080
LTI_CLIENT_ID=replace-with-moodle-client-id
LTI_DEPLOYMENT_ID=replace-with-moodle-deployment-id
LTI_AUTH_URL=http://localhost:8080/mod/lti/auth.php
LTI_TOKEN_URL=http://localhost:8080/mod/lti/token.php
LTI_JWKS_URL=http://localhost:8080/mod/lti/certs.php

# Local HTTP works only for a same-site localhost prototype. Use true + None
# when Moodle/editor/service are on different HTTPS sites.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=Lax
SESSION_TTL_SECONDS=28800

# Optional in-process HTTPS. Use PEM files trusted by Moodle and browsers.
# TLS_KEY_FILE=C:\\certs\\learning-service.key
# TLS_CERT_FILE=C:\\certs\\learning-service.crt
