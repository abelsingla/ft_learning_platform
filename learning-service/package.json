    "@types/node": "24.10.1",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
